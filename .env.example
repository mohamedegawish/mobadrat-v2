# Variables of docker-compose.yml.
#
# Coolify (Docker Compose build pack): nothing is required. Coolify generates the domain (SERVICE_URL_APP_4000), the MySQL
# passwords (SERVICE_PASSWORD_MYSQL, SERVICE_PASSWORD_MYSQLROOT) and JWT_SECRET (SERVICE_PASSWORD_64_JWT). Set below, in the
# resource's Environment Variables, only what you want to change (a value you set always wins).
#
# Any other Docker host: copy to .env, set the first block, then `docker compose up -d --build`. Never commit a real .env.
# Random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── required outside Coolify ──
# APP_URL=https://initiatives.example.gov.eg
# CORS_ORIGIN=https://initiatives.example.gov.eg
# SERVICE_PASSWORD_MYSQL=
# SERVICE_PASSWORD_MYSQLROOT=
# (JWT_SECRET is then generated by the app on its first start, into the app-data volume)

# ── accounts for every role (docs/DEPLOY.md «حسابات لكل دور») ──
# On by default: on the first start, one account per role of the platform and of each initiative + the demo data they
# need; on later starts only what is missing. Their password is the fixed seed password (docs/DEPLOY.md) — nothing to set.
# SEED_ON_DEPLOY=1
# SEED_EMAIL_DOMAIN=          (accounts on your domain: imc1@shams.local → imc1.shams@<domain>)

# ── mail: SMTP, or Gmail with an app password (needed for public sign-up activation and password reset links) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=المنصة الوطنية للمبادرات الصناعية
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── official enquiry channel shown on the site ──
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ── Shams El-Senaa: industrial registry ──
# manual (default): until the registry API is connected, factories register normally and upload their industrial
# registry certificate; IMC checks the number against it during the review (shown on every such application).
# When the API is ready: REGISTRY_ADAPTER=http with REGISTRY_API_URL and REGISTRY_API_KEY (automatic verification).
REGISTRY_ADAPTER=manual
REGISTRY_API_URL=
REGISTRY_API_KEY=

# ── optional ──
# MYSQL_DATABASE=mobadrat  MYSQL_USER=mobadrat
# PASSWORD_POOL_SIZE=8   (password-check workers; default cores−1, at most 4 ≈ 40 sign-ins/s — see docs/PERFORMANCE.md)
# SMS_PROVIDER= SMS_API_URL= SMS_API_KEY= SMS_SENDER=
# SHAMS_WEBHOOK_URL= SHAMS_WEBHOOK_SECRET= SONA3_WEBHOOK_URL= SONA3_WEBHOOK_SECRET=
