# Root .env for `docker compose` (docker-compose.yml) — copy to .env on the server and fill it. Never commit real secrets.
# Random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── public address (the domain served by the reverse proxy) ──
APP_URL=https://initiatives.example.gov.eg
CORS_ORIGIN=https://initiatives.example.gov.eg
JWT_SECRET=

# ── MySQL (the mysql service creates the database and the user on its first start) ──
MYSQL_DATABASE=mobadrat
MYSQL_USER=mobadrat
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── mail: SMTP, or Gmail with an app password ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=المنصة الوطنية للمبادرات الصناعية
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── official enquiry channel shown on the site ──
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ── Shams El-Senaa: industrial registry API (production refuses the mock adapter) ──
REGISTRY_ADAPTER=http
REGISTRY_API_URL=
REGISTRY_API_KEY=

# ── optional ──
# SMS_PROVIDER= SMS_API_URL= SMS_API_KEY= SMS_SENDER=
# SHAMS_WEBHOOK_URL= SHAMS_WEBHOOK_SECRET= SONA3_WEBHOOK_URL= SONA3_WEBHOOK_SECRET=
# Demo deployment only (empty database, never with real data): SEED_ON_BOOT=1 and SEED_PASSWORD=<12+ chars>
SEED_ON_BOOT=0
