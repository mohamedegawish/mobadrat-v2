{
  "openapi": "3.1.0",
  "info": {
    "title": "Shams El-Senaa — Integration API",
    "version": "1.0.0",
    "description": "API الربط بين موقع «شمس الصناعة» وأدمن المنصة الوطنية للمبادرات. قراءة الطلبات والملخصات وإدارة الجهات والحسابات ومقدمي الخدمة وقراءة سجل التدقيق. لا يوجد أي endpoint يتخذ قرارًا على الطلبات — القرار يبقى للجهة المسؤولة داخل الموقع. كل الردود الناجحة بالشكل { message, status: 'ok', data } وكل الأخطاء بالشكل { code, messageAr, messageEn, details? }. التواريخ ISO 8601 UTC والحقول camelCase."
  },
  "servers": [
    {
      "url": "/api/integration/v1/i/shams"
    }
  ],
  "security": [
    {
      "bearerApiKey": []
    },
    {
      "headerApiKey": []
    }
  ],
  "tags": [
    {
      "name": "read",
      "description": "النطاق read"
    },
    {
      "name": "read_documents",
      "description": "النطاق read_documents"
    },
    {
      "name": "manage_users",
      "description": "النطاق manage_users"
    },
    {
      "name": "read_audit",
      "description": "النطاق read_audit"
    }
  ],
  "paths": {
    "/summary": {
      "get": {
        "tags": [
          "read"
        ],
        "x-scope": "read",
        "operationId": "getSummary",
        "summary": "أعداد الطلبات لكل حالة، والمتأخرة، ومتوسط زمن كل مرحلة، والتعاقدات",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/applications": {
      "get": {
        "tags": [
          "read"
        ],
        "x-scope": "read",
        "operationId": "listApplications",
        "summary": "قائمة الطلبات بصفحات وفلاتر",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "حالة أو أكثر مفصولة بفاصلة",
            "schema": {
              "type": "string",
              "example": "IMC_REVIEW,ENCPC_REVIEW"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "من تاريخ (ISO) — على تاريخ الإرسال",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "governorate",
            "in": "query",
            "description": "رمز المحافظة (من GET /api/v1/meta)",
            "schema": {
              "type": "string",
              "example": "sharqia"
            }
          },
          {
            "name": "bankOrgId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "بحث برقم الطلب فقط (لا يبحث في اسم الشركة ولا رقم السجل)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeDrafts",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationPageEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/applications/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
