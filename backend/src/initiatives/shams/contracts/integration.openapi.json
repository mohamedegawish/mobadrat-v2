          {
            "name": "type",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/OrgType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationListEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "manage_users"
        ],
        "x-scope": "manage_users",
        "operationId": "createOrganization",
        "summary": "إضافة جهة (البنوك فقط — الجهات الهيكلية ثابتة والمصانع تسجل بنفسها)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganizationCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/organizations/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "tags": [
          "manage_users"
        ],
        "x-scope": "manage_users",
        "operationId": "updateOrganization",
        "summary": "تعديل جهة أو إيقافها (لا يمكن تعديل جهة إدارة النظام أو إيقاف الجهات الهيكلية)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganizationUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "manage_users"
        ],
        "x-scope": "manage_users",
        "operationId": "listUsers",
        "summary": "حسابات الجهات (حسابات المصانع مستبعدة إلا مع role=factory_owner)",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Role"
            }
          },
          {
            "name": "organizationId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPageEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "manage_users"
        ],
        "x-scope": "manage_users",
        "operationId": "createUser",
        "summary": "إنشاء حساب جهة بكلمة مرور مؤقتة (تُرجع مرة واحدة، ويجب تغييرها عند أول دخول). لا يمكن إنشاء system_admin عبر الربط",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserWithPasswordEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/users/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "tags": [
          "manage_users"
        ],
        "x-scope": "manage_users",
        "operationId": "updateUser",
        "summary": "تعديل حساب، إيقافه، أو إعادة تعيين كلمة المرور (لا يمكن تعديل حسابات إدارة النظام أو المصانع عبر الربط)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserWithPasswordEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/audit-logs": {
      "get": {
        "tags": [
          "read_audit"
        ],
        "x-scope": "read_audit",
        "operationId": "listAuditLogs",
        "summary": "سجل التدقيق (append-only)",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "application.accept"
            }
          },
          {
            "name": "applicationId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPageEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "webhooks": {
    "application.state_changed": {
      "post": {
        "summary": "يُرسل لكل انتقال حالة إلى PLATFORM_WEBHOOK_URL عبر outbox مع إعادة محاولة (1، 5، 15، 60 دقيقة؛ 5 محاولات).",
        "description": "التحقق: X-Shams-Signature = 'v1=' + hex(HMAC_SHA256(PLATFORM_WEBHOOK_SECRET, X-Shams-Timestamp + '.' + rawBody)). ارفض الطلبات الأقدم من 5 دقائق، وامنع التكرار بـ X-Shams-Event-Id (ثابت في كل إعادة محاولة). رد 2xx = تم التسليم.",
        "parameters": [
          {
            "name": "X-Shams-Event-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Shams-Event-Type",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "application.state_changed"
            }
          },
          {
            "name": "X-Shams-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Unix seconds"
            }
          },
          {
            "name": "X-Shams-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "v1=5f2b…"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StateChangedEvent"
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "delivered"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer shk_<prefix>_<secret>"
      },
      "headerApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "مفتاح غير صالح أو ملغى (INVALID_API_KEY)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "نطاق ناقص (INSUFFICIENT_SCOPE) أو عملية ممنوعة (FORBIDDEN)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "غير موجود",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "ValidationError": {
        "description": "VALIDATION_ERROR مع details",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Conflict": {
        "description": "تعارض (مثل EMAIL_TAKEN)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "RateLimited": {
        "description": "تجاوز حد المفتاح في الدقيقة (RATE_LIMITED)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "messageAr",
          "messageEn"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "messageAr": {
            "type": "string"
          },
          "messageEn": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "issue"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "issue": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ApplicationState": {
        "type": "string",
        "enum": [
          "DRAFT",
          "IMC_REVIEW",
          "IMC_CORRECTION",
          "ENCPC_REVIEW",
          "ENCPC_CORRECTION",
          "PROVIDER_SELECTION",
          "OFFER_UPLOAD",
          "OFFER_REVIEW",
          "OFFER_CORRECTION",
          "ELECTRICITY_UPLOAD",
          "ELECTRICITY_REVIEW",
          "BANK_STUDY",
          "CONTRACT_OUTCOME",
          "DISTRIBUTION_UPLOAD",
          "DISTRIBUTION_REVIEW",
          "REJECTED",
          "CONTRACTED",
          "CLOSED_NOT_CONTRACTED",
          "WITHDRAWN"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "factory_owner",
          "imc_reviewer",
          "encpc_reviewer",
          "pmu_reviewer",
          "electricity_reviewer",
          "bank_reviewer",
          "system_admin"
        ]
      },
      "OrgType": {
        "type": "string",
        "enum": [
          "factory",
          "imc",
          "encpc",
          "pmu",
          "electricity",
          "bank",
          "admin"
        ]
      },
      "ProviderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "approved",
          "suspended"
        ]
      },
      "Responsible": {
        "type": "object",
        "description": "الجهة المسؤولة حاليًا — النوع فقط (بلا اسم الجهة ولا معرفها: اسم جهة المصنع هو اسم الشركة)",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "factory",
              "imc",
              "encpc",
              "pmu",
              "electricity",
              "bank",
              "none"
            ]
          },
          "labelAr": {
            "type": "string"
          },
          "labelEn": {
            "type": "string"
          }
        }
      },
      "ApplicationListItem": {
        "type": "object",
        "description": "بيانات وصفية فقط (قرار المشروع 3). قائمة سماح صريحة في الخادم (integration/metadataView.ts). مستبعد عمدًا: اسم الشركة، رقم السجل الصناعي، بيانات الفورم والاتصال والضرائب، بيانات السجل، أسباب القرارات والنواقص، قيم التعاقد وملاحظات البنك، بيانات مقدم الخدمة، المستندات، أسماء المستخدمين.",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": [
              "string",
              "null"
            ],
            "example": "SHAMS-2026-00001"
          },
          "state": {
            "$ref": "#/components/schemas/ApplicationState"
          },
          "stateLabelAr": {
            "type": "string"
          },
          "stateLabelEn": {
            "type": "string"
          },
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "governorate": {
            "type": "string"
          },
          "industrialZone": {
            "type": "string"
          },
          "submittedAt": {
            "type": [
              "string",
