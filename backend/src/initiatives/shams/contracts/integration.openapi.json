        "summary": "بيانات الطلب الوصفية والسجل التاريخي الوصفي (قراءة فقط — بلا بيانات الفورم أو الأسباب أو المستندات)",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationDetailEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/applications/{id}/documents/{docId}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "docId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "read_documents"
        ],
        "x-scope": "read_documents",
        "operationId": "downloadDocument",
        "summary": "تنزيل مستند (PDF) — المستندات المُرسلة فقط",
        "responses": {
          "200": {
            "description": "PDF",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/organizations": {
      "get": {
        "tags": [
          "manage_users"
        ],
        "x-scope": "manage_users",
        "operationId": "listOrganizations",
        "summary": "الجهات (المصانع مستبعدة إلا مع type=factory)",
