{
  "name": "mobadrat-platform-server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:migrate:prod": "node dist/cli/migrate.js",
    "db:seed": "tsx src/cli/seed.ts",
    "admin:create": "tsx src/cli/createSuperAdmin.ts",
    "admin:create:prod": "node dist/cli/createSuperAdmin.js",
    "legacy:import": "tsx src/cli/legacy-import/index.ts",
    "legacy:import:prod": "node dist/cli/legacy-import/index.js",
    "test": "node scripts/run-tests.mjs",
    "test:core": "node scripts/run-tests.mjs core",
    "test:shams": "node scripts/run-tests.mjs shams",
    "test:sona3": "node scripts/run-tests.mjs sona3",
    "lint:async": "node scripts/check-async.mjs && eslint \"src/**/*.ts\"",
    "check:readiness": "tsx src/cli/checkReadiness.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "3.24.6",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "10.12.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.2",
    "xlsx": "^0.18.5"
  }
}
