# Local development (copy to backend/.env). MySQL runs in Docker:  docker compose -f docker-compose.dev.yml up -d mysql
NODE_ENV=development
PORT=5000
# Defaults match docker-compose.dev.yml (127.0.0.1:3306, database/user/password mobadrat). Or: DATABASE_URL=mysql://user:pass@host:3306/db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mobadrat
DB_USER=mobadrat
DB_PASSWORD=mobadrat
UPLOAD_DIR=./data/uploads
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
# Demo accounts of the platform and of every initiative on an empty database (password Mobadrat@2026 in development).
SEED_ON_BOOT=1
# Shams El-Senaa industrial registry: mock in development.
REGISTRY_ADAPTER=mock
# Mail: empty = messages are logged only. MAIL_REDIRECT_TO sends every message to one address outside production.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_REDIRECT_TO=
SUPPORT_EMAIL=
SUPPORT_PHONE=
